# Sunucuda bio-dash klasöründe .env olarak kopyalayın: cp deploy/env.production.example .env
# Değerleri düzenleyin; özellikle şifreler ve secret'lar.
# ÖNEMLİ: Bu dosyaya "cd ...", "docker compose" gibi shell komutları yazmayın; sadece KEY=değer satırları.

# --- Domain (tarayıcı + CORS + NextAuth) ---
NEXT_PUBLIC_API_BASE_URL=https://ore-oar.online/backend
NEXTAUTH_URL=https://ore-oar.online
CORS_ALLOW_ORIGINS=https://ore-oar.online,https://www.ore-oar.online

# --- Güvenlik (üretimde mutlaka güçlü rastgele değerler) ---
AUTH_SECRET=degistir-en-az-32-karakter-rastgele
JWT_SECRET=degistir-baska-bir-rastgele-deger

# Opsiyonel
# JWT_ROTATION_EPOCH=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- PostgreSQL (docker-compose içi) ---
POSTGRES_PASSWORD=guclu-bir-veritabani-sifresi

# docker-compose.yml POSTGRES_PASSWORD değişkenini postgres servisi ve tüm DATABASE_URL satırlarında kullanır.

# --- Portlar: sadece localhost (Nginx reverse proxy için) ---
# docker-compose.yml zaten container portunu ekler (:3000, :8000, ...). Burada YALNIZCA host tarafı yazılır.
FRONTEND_PORT=127.0.0.1:3001
BACKEND_PORT=127.0.0.1:8000
POSTGRES_PORT=127.0.0.1:5433
REDIS_PORT=127.0.0.1:6379

# Container içi backend adresi (değiştirmeyin)
INTERNAL_BACKEND_URL=http://backend:8000
